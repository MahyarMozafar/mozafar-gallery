# ---------------------------------------------------------------
# کپی کن به .env و مقدارها را پر کن.  فایل .env هرگز به گیت نمی‌رود.
# Copy to .env and fill in.  .env is never committed.
# ---------------------------------------------------------------

# پایگاه داده
DATABASE_URL="file:./dev.db"

# کلید رمزنگاری نشست کاربر — یک رشته تصادفی بلند
# openssl rand -base64 32
SESSION_SECRET=""

# --- قیمت طلا ---
# manual = قیمت دستی از پنل مدیریت (پیش‌فرض، کلید لازم ندارد)
# brsapi = برای زمانی که کلید خریدی
GOLD_PRICE_PROVIDER="manual"
BRSAPI_KEY=""

# --- پیامک (کد ورود) ---
# در حالت توسعه خالی بگذار؛ کد در ترمینال چاپ می‌شود.
SMS_PROVIDER="console"
KAVENEGAR_API_KEY=""
